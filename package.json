{
	"name": "forge",
	"version": "0.5.0",
	"description": "Scaffold standardized apps with optional Turborepo, Replit support, and Vercel deployment",
	"type": "module",
	"main": "./dist/index.js",
	"bin": {
		"forge": "./bin/forge.js"
	},
	"scripts": {
		"install:forge": "pnpm build && pnpm link --global",
		"publish:installer:gist": "FORGE_GIST_ID=<insert gist> bash ./scripts/publish-installer-gist.sh",
		"dev": "tsx src/index.ts",
		"dev:config": "tsx src/index.ts config",
		"build": "tsup src/index.ts --format esm --dts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --reporter=verbose",
		"test:smoke": "vitest run --config vitest.integration.config.ts --reporter=verbose smoke.integration",
		"test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
		"test:all": "pnpm test && pnpm test:integration",
		"test:watch": "vitest"
	},
	"keywords": [
		"cli",
		"scaffold",
		"turborepo",
		"nextjs",
		"monorepo",
		"replit",
		"vercel",
		"supabase"
	],
	"author": "Trey Hicks",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.19.15",
		"@types/prompts": "^2.4.9",
		"@types/react": "^19.2.14",
		"@types/validate-npm-package-name": "^4.0.2",
		"agent-browser": "^0.23.4",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"commander": "^12.1.0",
		"dotenv": "^17.3.1",
		"execa": "^9.6.1",
		"fs-extra": "^11.3.4",
		"ink": "^6.8.0",
		"kleur": "^4.1.5",
		"ora": "^8.2.0",
		"prompts": "^2.4.2",
		"react": "^19.2.4",
		"validate-npm-package-name": "^7.0.2",
		"vercel": "^50.38.3"
	}
}
